{
  "name": "yasira-motors",
  "version": "1.0.0",
  "private": true,
  "description": "Сайт автосервиса YASIRA MOTORS (Актау, Казахстан)",
  "scripts": {
    "dev": "next dev --webpack",
    "build": "next build --webpack",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "node --import ./scripts/register-test-resolver.mjs --test \"tests/*.test.ts\"",
    "test:vitest": "vitest run",
    "test:e2e": "playwright test",
    "qa:audit": "playwright test qa/audit --reporter=list"
  },
  "dependencies": {
    "@radix-ui/react-dialog": "1.1.23",
    "lucide-react": "1.48.0",
    "next": "16.3.6",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.13.0",
    "@playwright/test": "1.63.0",
    "@tailwindcss/postcss": "4.3.3",
    "@types/node": "22.19.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "eslint": "9.39.1",
    "eslint-config-next": "16.3.6",
    "prettier": "3.9.9",
    "prettier-plugin-tailwindcss": "0.8.1",
    "tailwindcss": "4.3.3",
    "typescript": "5.9.3",
    "vitest": "5.0.2"
  },
  "engines": {
    "node": ">=20.9.0"
  }
}
