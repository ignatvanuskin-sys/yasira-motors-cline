# ── Сайт ─────────────────────────────────────────────────────────────────────
# Публичный адрес сайта без слеша в конце. Используется для canonical,
# sitemap.xml, robots.txt, Open Graph и микроразметки.
#
# ⚠ Задайте реальный домен. Если переменная пуста, подставляется запасной
# адрес https://yasira-motors.vercel.app, который этому проекту не принадлежит.
NEXT_PUBLIC_SITE_URL=

# ── Аналитика (необязательно) ────────────────────────────────────────────────
# Если пусто — аналитика не подключается, события не отправляются.
NEXT_PUBLIC_GA_ID=

# ── Флаги функциональности ───────────────────────────────────────────────────
# Казахская версия (/kk). Маршруты НЕ реализованы — не включайте: словари
# messages/kk.json готовы, но страниц /kk и /kk/uslugi/[slug] в проекте нет.
ENABLE_KK=false

# Блок «Масла и магазин». Включать только после подтверждения владельца,
# что магазин работает по актуальному адресу.
SHOW_SHOP=false
