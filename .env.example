# ── Сайт ─────────────────────────────────────────────────────────────────────
# Публичный адрес сайта (без слеша в конце). Используется для canonical,
# sitemap.xml, robots.txt и Open Graph.
NEXT_PUBLIC_SITE_URL=https://yasira-motors.vercel.app

# ── Telegram-доставка заявок ─────────────────────────────────────────────────
# Токен бота и чат владельца. ТОЛЬКО на сервере — никогда не используйте
# префикс NEXT_PUBLIC_ для этих переменных, иначе токен попадёт в клиентский JS.
# Как получить: @BotFather → /newbot → токен; написать боту → chat id.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# ── Аналитика (необязательно) ────────────────────────────────────────────────
# Если пусто — аналитика не подключается, события не отправляются.
NEXT_PUBLIC_GA_ID=

# ── Флаги функциональности ───────────────────────────────────────────────────
# Казахская версия сайта (/kk). Пока false — переключатель языка скрыт,
# но все казахские тексты и страницы уже подготовлены.
ENABLE_KK=false

# Блок «Масла и магазин». Включать только после подтверждения владельца,
# что магазин работает по актуальному адресу.
SHOW_SHOP=false
